# App
APP_NAME=relinqo
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8081
PUBLIC_BASE_URL=https://yourdomain.com
SESSION_SECRET=change-this-random-64-char-secret

# Review queue auth (HTTP Basic)
REVIEW_USERNAME=admin
REVIEW_PASSWORD=change-this-password

# Forwarded-email intake token
FORWARDING_TOKEN=change-this-token

# Database
# Local single-process development can use SQLite:
# DATABASE_URL=sqlite:///./data/leadrelay.db
#
# Current Doteasy production uses MySQL via PyMySQL:
DATABASE_URL=mysql+pymysql://user:change-this-password@localhost/dariomed_relinqo?charset=utf8mb4
REQLINQO_RUN_MIGRATIONS_ON_STARTUP=true
#
# PostgreSQL remains supported for other hosts:
# DATABASE_URL=postgresql+psycopg://leadrelay:change-this-password@postgres:5432/leadrelay

# Lead handling
HUMAN_REVIEW=true
AUTO_SEND_CONFIDENCE_THRESHOLD=0.9
DEFAULT_TIMEZONE=America/Edmonton

# Google OAuth for Gmail and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner notifications
OWNER_ALERT_EMAIL=owner@example.com
DIGEST_TO_EMAIL=owner@example.com

# SMTP (leave blank to disable email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=alerts@example.com

# IMAP inbox polling (leave blank to disable)
INBOX_POLL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN

# AI — set provider to "anthropic" and add your API key to enable AI features
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Twilio platform account for SMS alerts, missed-call rescue, and provisioning
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ALERT_TO_NUMBER=

# Stripe Billing - hosted Checkout + Customer Portal for the full service plan
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use a pre-created recurring Stripe Price instead of inline price_data
STRIPE_PRICE_ID=
STRIPE_PRICE_AMOUNT_CENTS=9999
STRIPE_PRICE_CURRENCY=usd
STRIPE_PRODUCT_NAME=relinqo Full Service
BILLING_ENFORCED=true
# Required only for POST /api/billing/admin/bypass
BILLING_ADMIN_TOKEN=change-this-admin-token

# Business profile — the AI uses this to respond on behalf of the business
BUSINESS_NAME=Acme Plumbing & Heating
BUSINESS_SERVICES=plumbing, heating, cooling, drain cleaning, water heater installation
BUSINESS_AREA=Edmonton and surrounding area
BUSINESS_HOURS=Mon-Fri 8am-5pm, emergency service 24/7
BUSINESS_PHONE=(780) 555-0100
BUSINESS_TONE=friendly and professional
BUSINESS_REPLY_SIGNATURE=

# Public live demo contact surface
# Create demo@yourdomain.com in cPanel and forward parsed messages into /api/demo/inbound.
# Point the demo Twilio number's Messaging webhook to /demo/sms/webhook.
# Point the demo Twilio number's Voice webhook to /demo/voice/incoming.
DEMO_INBOX_EMAIL=demo@yourdomain.com
DEMO_PHONE_NUMBER=+17825550100
DEMO_FORWARDING_TOKEN=change-this-demo-token
